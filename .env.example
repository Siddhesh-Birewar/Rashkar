# Rashkar Environment Configuration Example
# Copy this file to .env and configure local/production settings.
# NEVER commit the actual .env file or credentials to source control.

# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Rashkar Climate-Smart Agriculture Platform"
API_V1_STR="/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Timezone
TIMEZONE="Asia/Kolkata"

# Database (PostgreSQL 16 with PostGIS 3.4)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rashkar_admin
POSTGRES_PASSWORD=rashkar_secure_password
POSTGRES_DB=rashkar_db
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# SQLite Fallback for Local Testing (if PostgreSQL is not running)
SQLITE_DB_PATH="rashkar_dev.db"

# Cache & Message Broker (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/1

# External Services & APIs (Leave blank if not yet acquired)
# IMD Public Weather API
IMD_API_BASE_URL="https://api.imd.gov.in/public"
IMD_API_TOKEN=""

# Copernicus CDS (AgERA5 & ERA5-Land)
CDSAPI_URL="https://cds.climate.copernicus.eu/api"
CDSAPI_KEY=""

# Upstream CropNet Service
CROPNET_API_BASE_URL="http://localhost:8080/api/v1"
CROPNET_API_TOKEN=""
USE_CROPNET_MOCK=true

# Storage paths
DATA_DIR="data"
RAW_DATA_DIR="data/01_raw_immutable"
PROCESSED_DATA_DIR="data/02_processed"
FEATURE_DATA_DIR="data/03_features"
FIXTURES_DATA_DIR="data/05_fixtures"
