# Environment Configuration Template for CropNet AI

ENVIRONMENT=development
APP_NAME="CropNet AI Backend"
API_V1_PREFIX="/api/v1"
LOG_LEVEL=INFO

# Supabase Auth & Project
SUPABASE_AUTH_ENABLED=true
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key-keep-backend-only
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_PROJECT_REF=your-project-ref

# Database Connection (PostgreSQL 16/17 + PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SYNC_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Weather APIs (OpenWeather)
OPENWEATHER_API_KEY=your-openweather-api-key
OPENWEATHER_API_KEY_FALLBACK=your-openweather-fallback-key

# Map Tile Provider (MapTiler)
MAPTILER_API_KEY=your-maptiler-api-key
MAPTILER_API_KEY_FALLBACK=your-maptiler-fallback-key

# Soil Data Providers
SOILGRIDS_WCS_BASE_URL=https://maps.isric.org/mapserv
SOILGRIDS_TIMEOUT_SECONDS=25
OPENLANDMAP_BASE_URL=http://s3.opengeohub.org/global-soil/global_soil_props_v20250204_mosaics
BHOOMI_GEOSERVER_URL=https://bhoomigeoportal-nbsslup.in/geoserver
NATMO_PORTAL_URL=https://geoportal.natmo.gov.in

# Feature Flags
ENABLE_LOCAL_RASTER_CACHE=true
LOCAL_RASTER_CACHE_DIR=./data_cache/rasters
ENABLE_ECONOMIC_RANKING=false
ENABLE_YIELD_PREDICTION=false
